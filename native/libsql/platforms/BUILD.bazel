# platform() targets for cross-compiling the Rust libsql JNI bridge.
#
# `@rules_rust//rust/platform:<triple>` (e.g. `x86_64-unknown-linux-gnu`) looks
# like a platform but is actually a `config_setting()` — rules_rust's own
# `declare_config_settings()` (rust/platform/platform.bzl) only emits real
# `native.platform(...)` targets for the wasm/wasi triples; every standard
# arch/OS triple gets a `config_setting()` instead, which does not provide
# `PlatformInfo` and cannot be passed to `--platforms=`:
#   ERROR: Target @@rules_rust+//rust/platform:x86_64-unknown-linux-gnu was
#   referenced as a platform, but does not provide PlatformInfo
# This is true across rules_rust versions (verified at 0.49.3 and 0.70.0) and
# was never a working invocation in this repo — the fast-exit `check` job in
# build-native-libs.yml skipped the actual `bazel build` step on every run
# from 2026-06-19 until the source hash next changed, so the bug went
# undetected for two months.
#
# The fix: define real `platform()` targets here using the same
# triple -> constraint_value mapping rules_rust uses internally to register
# its toolchains (rust/platform/triple_mappings.bzl: cpu_arch_to_constraints,
# system_to_constraints), and reference these from --platforms= instead.
# Toolchain resolution still finds the matching rust_toolchain registered by
# MODULE.bazel's `rust.toolchain(extra_target_triples = [...])`, since that
# toolchain is constrained by the identical constraint_values.

platform(
    name = "x86_64-unknown-linux-gnu",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "aarch64-unknown-linux-gnu",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

platform(
    name = "aarch64-apple-darwin",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
)

platform(
    name = "x86_64-apple-darwin",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:osx",
    ],
)

platform(
    name = "x86_64-pc-windows-msvc",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
)

platform(
    name = "aarch64-linux-android",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:android",
    ],
)

platform(
    name = "x86_64-linux-android",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:android",
    ],
)
