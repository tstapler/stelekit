"""
businessTest — business logic tests (no UI dependencies).

This source set compiles against jvm_main_lib; it has no Compose or platform
dependencies, making it fast to run in CI.
"""

load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library", "kt_jvm_test")
load("@rules_java//java:defs.bzl", "java_library")

# Bundles DemoFileSystem.kt as a classpath resource so DemoFileSystemSyncTest
# can read it without a filesystem walk (needed for Bazel's sandboxed runs).
java_library(
    name = "demo_filesystem_as_resource",
    resources = ["//kmp/src/commonMain/kotlin:demo_filesystem_source"],
    resource_strip_prefix = "kmp/src/commonMain/kotlin/dev/stapler/stelekit/platform",
)

# Bundles SteleDatabase.sq as a classpath resource ("SteleDatabase.sq") so
# MigrationRunnerSchemaSyncTest can read it under Bazel without the Gradle-only
# -Dstelekit.sq.file system property.
java_library(
    name = "sqldatabase_schema_as_resource",
    resources = ["//kmp:sqldelight_schema_source"],
    resource_strip_prefix = "kmp/src/commonMain/sqldelight/dev/stapler/stelekit/db",
)

# Bundles GitShadowWorktree.kt as a classpath resource ("GitShadowWorktree.kt") so
# GitShadowWorktreeNoCoroutineScopeTest can read its source text under Bazel.
java_library(
    name = "git_shadow_worktree_as_resource",
    resources = ["//kmp/src/androidMain/kotlin:git_shadow_worktree_source"],
    resource_strip_prefix = "kmp/src/androidMain/kotlin/dev/stapler/stelekit/git",
)

# Bundle the three sources LfsStagingCallSitesStructuralTest scans for unguarded staging calls
# (resource names GitSyncService.kt, JvmGitRepository.kt, AndroidGitRepository.kt).
java_library(
    name = "git_sync_service_as_resource",
    resources = ["//kmp/src/commonMain/kotlin:git_sync_service_source"],
    resource_strip_prefix = "kmp/src/commonMain/kotlin/dev/stapler/stelekit/git",
)

java_library(
    name = "jvm_git_repository_as_resource",
    resources = ["//kmp/src/jvmMain/kotlin:jvm_git_repository_source"],
    resource_strip_prefix = "kmp/src/jvmMain/kotlin/dev/stapler/stelekit/git",
)

java_library(
    name = "android_git_repository_as_resource",
    resources = ["//kmp/src/androidMain/kotlin:android_git_repository_source"],
    resource_strip_prefix = "kmp/src/androidMain/kotlin/dev/stapler/stelekit/git",
)

# Bundles gap-backlog.md and plan.md as classpath resources ("gap-backlog.md",
# "plan.md") for DocRepoLocator's Bazel path — see DocRepoLocator's class doc.
java_library(
    name = "rich_editing_backlog_docs_as_resources",
    resources = ["//:rich_editing_backlog_docs"],
    resource_strip_prefix = "project_plans/rich-editing-experience/implementation",
)

# Bundles docs/journeys/*.md as classpath resources under "journeys/" (e.g.
# "journeys/insert-tag.md") for DocRepoLocator's Bazel path.
java_library(
    name = "journey_docs_as_resources",
    resources = ["//:journey_docs_source"],
    resource_strip_prefix = "docs",
)

# ── Wiring and test-audit inputs (WiringInputs.kt) ─────────────────────────────
# java_library(resources=...) takes ONE resource_strip_prefix per target, so there is one library per
# distinct prefix. Stripping to "kmp/src" keeps the source-set directory in the resource name
# ("commonMain/kotlin/dev/stapler/stelekit/..."), so same-named files in different source sets
# (desktop/Main.kt vs browser/Main.kt) never collide.
java_library(
    name = "wiring_kmp_sources_as_resources",
    resources = [
        "//kmp/src/androidInstrumentedTest/kotlin:test_audit_sources",
        "//kmp/src/androidMain/kotlin:wiring_audit_sources",
        "//kmp/src/androidUnitTest/kotlin:test_audit_sources",
        "//kmp/src/commonMain/kotlin:wiring_audit_sources",
        "//kmp/src/commonTest/kotlin:test_audit_sources",
        "//kmp/src/iosMain/kotlin:wiring_audit_sources",
        "//kmp/src/jvmCommonMain/kotlin:wiring_audit_sources",
        "//kmp/src/jvmMain/kotlin:wiring_audit_sources",
        "//kmp/src/jvmTest/kotlin:test_audit_sources",
        "//kmp/src/wasmJsMain/kotlin:wiring_audit_sources",
        ":business_test_sources",
    ],
    resource_strip_prefix = "kmp/src",
)

filegroup(
    name = "business_test_sources",
    srcs = glob(["**/*.kt"]),
)

# androidApp/src/main and /test keep "src/main/kotlin/..." and "src/test/kotlin/..." names.
java_library(
    name = "wiring_androidapp_sources_as_resources",
    resources = [
        "//androidApp:wiring_main_sources",
        "//androidApp:wiring_test_sources",
    ],
    resource_strip_prefix = "androidApp",
)

# wiring-allowlist.txt, wiring-catalog.txt, first-open-screens.txt, test-*-baseline.txt, ...
java_library(
    name = "business_test_data_as_resources",
    resources = ["//kmp/src/businessTest/resources:business_test_data"],
    resource_strip_prefix = "kmp/src/businessTest/resources",
)

# The ReachabilityBaseline copy ("reachability-baseline.txt"); a second strip prefix, so a second library.
java_library(
    name = "reachability_baseline_as_resource",
    resources = ["//scripts/ci:reachability-baseline.txt"],
    resource_strip_prefix = "scripts/ci",
)

# ObservableEffect (commonTest) for the wiring tests; no @Test classes, so the completeness guard ignores it.
kt_jvm_library(
    name = "observable_effect",
    srcs = ["//kmp/src/commonTest/kotlin:observable_effect_source"],
    testonly = True,
    kotlinc_opts = "//:kmp_jvm_kotlinc_opts",
    deps = ["@maven//:org_jetbrains_kotlin_kotlin_stdlib"],
)

# Runnable test target — bazel test //kmp:business_tests
kt_jvm_test(
    name = "business_tests",
    srcs = glob(["**/*.kt"]),
    test_class = "dev.stapler.stelekit.AllBusinessTests",
    # DriverFactory resolves its data dir from user.home; the real home is not writable in the
    # test sandbox, so GraphManager tests that open a file DB failed with SQLITE_CANTOPEN.
    jvm_flags = ["-Duser.home=$$TEST_TMPDIR"],
    kotlinc_opts = "//:kmp_jvm_kotlinc_opts",
    associates = ["//kmp/src/jvmMain/kotlin:jvm_main_lib"],
    deps = [
        "@maven//:org_jetbrains_kotlin_kotlin_test_junit",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_test_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
        "@maven//:org_jetbrains_kotlin_kotlin_stdlib",
        "@maven//:io_kotest_kotest_property_jvm",
        "//kmp/src/commonMain/resources:common_resources",
        "//kmp/src/commonTest/kotlin:git_testsupport",
        "//kmp/src/commonTest/kotlin:business_common_tests",
        "//kmp/src/commonTest/kotlin:merge_fixtures",
        "@maven//:com_squareup_okio_okio_fakefilesystem_jvm",
        ":demo_filesystem_as_resource",
        ":sqldatabase_schema_as_resource",
        ":git_shadow_worktree_as_resource",
        ":git_sync_service_as_resource",
        ":jvm_git_repository_as_resource",
        ":android_git_repository_as_resource",
        ":rich_editing_backlog_docs_as_resources",
        ":journey_docs_as_resources",
        ":wiring_kmp_sources_as_resources",
        ":wiring_androidapp_sources_as_resources",
        ":business_test_data_as_resources",
        ":reachability_baseline_as_resource",
        ":observable_effect",
    ],
    visibility = ["//kmp:__subpackages__"],
)
