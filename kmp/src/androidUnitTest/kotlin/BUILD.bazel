"""
androidUnitTest — Android local unit tests via Robolectric.

Screenshot tests using roborazzi are excluded (kept in Gradle).

Note: The @robolectric//bazel:android-all shorthand is not available because
the robolectric module is not in BCR for the required version. Instead,
android-all is declared as a Maven artifact directly.

To run: bazel test //kmp/src/androidUnitTest/kotlin:android_unit_tests
"""

load("@rules_android//rules:rules.bzl", "android_local_test")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")

# Compile test sources into an Android library first
kt_android_library(
    name = "android_unit_test_lib",
    srcs = glob(
        ["**/*.kt"],
        exclude = [
            # Roborazzi screenshot tests — no Bazel integration; kept in Gradle
            "**/*Roborazzi*.kt",
            "**/*Screenshot*.kt",
            # Uses Roborazzi captureRoboImage (no Bazel integration; Gradle-only)
            "**/AnnotationEditorInsetsLayoutTest.kt",
            # Composes @Composable lambdas; this target has no Compose compiler plugin (Gradle-only)
            "**/ArchiveUrlEntryPointTest.kt",
            # Composes @Composable lambdas; no Compose compiler plugin in this target (Gradle-only)
            "**/AnnotateImageEntryPointTest.kt",
            # Compose host tests for the flagged project list and settings panel (Gradle-only, R-AU)
            "**/ProjectSettingsPanelTest.kt",
            "**/ProjectListPhoneLayoutTest.kt",
            "**/SketchEmbedUiTest.kt",
            "**/SourcePagePickerTest.kt",
            "**/DrawingAttachUiTest.kt",
            "**/RegistryEditorScreenTest.kt",
            "**/RegistryEditorDialogsTest.kt",
            # Compose gesture/host tests for the flagged Sketch screen (Gradle-only, R-AU)
            "**/SketchCanvasGestureTest.kt",
            # Compose host test for the sketch input spike (Gradle-only, no Compose plugin in this target)
            "**/InputSpikeAndroidTest.kt",
            # Compose host tests for the v2 pointer adapter and text overlay (Gradle-only, no Compose plugin in this target)
            "**/PointerAdapterTest.kt",
            "**/TextEditorTest.kt",
            # Compose host test for the selection overlay and handle tiers (Gradle-only, no Compose plugin in this target)
            "**/HandleLayoutTest.kt",
            # Compose host tests for the v2 edge-pan strip and the diagnostics host (Gradle-only, no Compose plugin in this target)
            "**/EdgePanStripTest.kt",
            "**/DiagnosticsTest.kt",
            # Compose host tests for the v2 touch help popup, non-drag transform panel, pan pad and sheet handle (Gradle-only, no Compose plugin in this target)
            "**/TouchHelpTest.kt",
            "**/NonDragTransformTest.kt",
            # Compose host tests for the v2 discoverability, coach walkthrough and empty state (Gradle-only, no Compose plugin in this target)
            "**/DiscoverabilityTest.kt",
            "**/CoachWalkthroughTest.kt",
            "**/EmptyStateTest.kt",
            # Compose host test for the v2 solve progress indicator (Gradle-only, no Compose plugin in this target)
            "**/SolveProgressIndicatorTest.kt",
            # Compose host tests for the v2 scene semantics and the technical-data panel (Gradle-only, no Compose plugin in this target)
            "**/SceneSemanticsTest.kt",
            "**/TechnicalDataPanelTest.kt",
            # Compose host tests for the v2 layers panel, style panel and shortcuts sheet (Gradle-only, no Compose plugin in this target)
            "**/LayersPanelTest.kt",
            "**/StylePanelTest.kt",
            "**/ShortcutsSheetTest.kt",
            "**/ElementsPanelTest.kt",
            # Compose host tests and commonTest-fixture pixel test for the v2 strip, shell and painter (Gradle-only)
            # Compose host tests for the v2 chrome budget, action chip row, toast lane, top bar and capacity messages (Gradle-only, no Compose plugin in this target)
            "**/ChromeBudgetTest.kt",
            "**/ActionChipRowTest.kt",
            "**/TopBarTest.kt",
            "**/CapacityUxTest.kt",
            "**/ToolStripTest.kt",
            "**/AdaptiveStateSurvivalTest.kt",
            "**/SketchCanvasRecompositionTest.kt",
            "**/ScenePainterAndroidTest.kt",
            # Task 6.2.4a: the architecture scenario needs the commonTest fixtures; the UX acceptance test also composes the strip (Gradle-only)
            "**/ArchitectureScenarioAndroidTest.kt",
            "**/UxAuthoringAcceptanceTest.kt",
            "**/SketchScreenEntryPointTest.kt",
            "**/HomeSketchFlowEntryPointTest.kt",
            # Composes the root text-metrics provider (Gradle-only, no Compose plugin here)
            "**/TextMetricsAndroidEntryPointTest.kt",
            # Composes the root store provider and needs the commonTest FakeFileSystem (Gradle-only, no Compose plugin here)
            "**/SketchStorageAndroidEntryPointTest.kt",
            "**/DimensionFieldTest.kt",
            "**/SketchSheetPanelsTest.kt",
            "**/SketchDeleteAndPreviewTest.kt",
            "**/SketchA11yTest.kt",
            # Compose host test for the Labs settings toggle (Gradle-only, R-AU)
            "**/LabsFlagToggleTest.kt",
            # Compose host test for the annotate non-drag placement UI (Gradle-only, no Compose plugin here)
            "**/AnnotationNonDragModeTest.kt",
            # Compose host test for annotate zoom/pan (Gradle-only, no Compose plugin here)
            "**/AnnotationZoomPanTest.kt",
            # Compose host test for the plane reference panel (Gradle-only, no Compose plugin here)
            "**/PlaneReferencePanelTest.kt",
            # Compose host test for the height-offset dialog (Gradle-only, no Compose plugin here)
            "**/HeightOffsetDialogTest.kt",
            # Compose host test for the height-offset dialog (Gradle-only, no Compose plugin here)
            "**/HeightOffsetDialogTest.kt",
            # Compose host test for the measurement advice strip (Gradle-only, no Compose plugin here)
            "**/MeasurementAdviceStripTest.kt",
            # Compose host test for the ruler tick panel (Gradle-only, no Compose plugin here)
            "**/RulerTickPanelTest.kt",
            # Compose host test for the PNG calibration step (Gradle-only, no Compose plugin here)
            "**/RasterTaggingPanelTest.kt",
            # Spike 0.1.3e Robolectric pixel probe: needs commonTest DeterminismSpikeSupport (Gradle-only)
            "**/AndroidPixelSpikeTest.kt",
            # Compose host test for the leave-sketch prompt (Gradle-only, no Compose plugin in this target)
            "**/LeaveSketchPromptTest.kt",
            # Compose host test for the restore and delete-backups dialogs (Gradle-only, no Compose plugin in this target)
            "**/RestoreBackupDialogTest.kt",
            # Compose host test for the sketch v2 migration and enablement composables (Gradle-only, no Compose plugin in this target)
            "**/MigrationUiTest.kt",
            # Compose host test for the sketch copy result dialog (Gradle-only, no Compose plugin in this target)
            "**/SketchCopyDialogTest.kt",
            # Compose host test for the sketch embed dispatcher (Gradle-only, no Compose plugin or commonTest in this target)
            "**/SketchRenderDispatcherTest.kt",
        ],
    ),
    custom_package = "dev.stapler.stelekit",
    testonly = True,
    kotlinc_opts = "//:kmp_android_kotlinc_opts",
    associates = ["//kmp/src/androidMain/kotlin:android_main"],
    deps = [
        "@maven//:junit_junit",
        "@maven//:org_jetbrains_kotlin_kotlin_test_junit",
        "@maven//:org_robolectric_robolectric",
        "@maven//:androidx_test_core",
        "@maven//:androidx_test_ext_junit",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_test_jvm",
        "@maven//:androidx_arch_core_core_testing",
        "@maven//:io_ktor_ktor_client_mock_jvm",
        "@maven//:androidx_glance_glance_appwidget_testing",
        "@maven//:androidx_work_work_testing",
        "@maven//:org_jetbrains_kotlin_kotlin_stdlib",
        "@maven//:androidx_compose_ui_ui_test_junit4",
        "@maven//:androidx_compose_ui_ui_test_manifest",
        "//kmp/src/commonTest/kotlin:git_testsupport_android",
        "//kmp/src/commonTest/kotlin:fake_file_system_android",
        "//kmp/src/commonTest/kotlin:observable_effect_android",
        "//kmp/src/commonTest/kotlin:scheduler_contract_fixtures_android",
        "//kmp/src/commonTest/kotlin:sketch_chrome_fixture_android",
    ],
)

android_local_test(
    name = "android_unit_tests",
    manifest = "//androidApp:BazelAndroidManifest.xml",
    test_class = "dev.stapler.stelekit.AllAndroidUnitTests",
    # android-all provides robolectric-deps.properties in the test's runfiles so that
    # android_local_test can find the Android SDK JARs when running offline (-Drobolectric.offline=true).
    data = ["@rules_robolectric//bazel:android-all"],
    deps = [
        ":android_unit_test_lib",
        "@maven//:org_robolectric_robolectric",
    ],
    visibility = ["//visibility:public"],
)

# All androidUnitTest sources for TestHygieneAuditTest and the catalog checks.
# Bundled as classpath resources by //kmp/src/businessTest/kotlin:wiring_kmp_sources_as_resources so
# the wiring and test-audit gates (businessTest/.../wiring, .../audit) can read sources under Bazel's
# sandbox. A subdirectory with its own BUILD.bazel is not crossed by glob(); none exists here.
filegroup(
    name = "test_audit_sources",
    srcs = glob(["**/*.kt"]),
    visibility = ["//kmp/src/businessTest/kotlin:__pkg__"],
)
