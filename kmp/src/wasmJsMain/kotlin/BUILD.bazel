# Not built by Bazel (wasmJs compiles via Gradle); this package only stages sources for
# jvmTest's PatLeakageAuditTest, which scans them as plain files.
filegroup(
    name = "git_sources",
    srcs = glob(["dev/stapler/stelekit/git/**/*.kt"]),
    visibility = ["//kmp/src/jvmTest/kotlin:__pkg__"],
)

# All wasmJsMain sources for WiringCompletenessTest.
# Bundled as classpath resources by //kmp/src/businessTest/kotlin:wiring_kmp_sources_as_resources so
# the wiring and test-audit gates (businessTest/.../wiring, .../audit) can read sources under Bazel's
# sandbox. A subdirectory with its own BUILD.bazel is not crossed by glob(); none exists here.
filegroup(
    name = "wiring_audit_sources",
    srcs = glob(["**/*.kt"]),
    visibility = ["//kmp/src/businessTest/kotlin:__pkg__"],
)
