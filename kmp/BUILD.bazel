"""
kmp/ package — top-level developer-facing aliases.

Developer commands:
  bazel run  //kmp:desktop_app          # Launch SteleKit desktop UI
  bazel run   //kmp:sketch_cli -- help  # Headless sketch tools for agents (render/validate/describe/build)
  bazel build //kmp:android_app         # Build Android APK
  bazel test  //kmp:jvm_tests           # Run JVM (desktop + shared) test suite
  bazel test  //kmp:business_tests      # Run business-logic only tests (no UI)
  bazel mobile-install //kmp:android_app  # Install APK on connected device

See CLAUDE.md for the full Gradle → Bazel command equivalence table.
"""

load("@bazel_rules_detekt//detekt:defs.bzl", "detekt_test")
load("@rules_android//rules:rules.bzl", "android_library")
load("//kmp:module_tests_manifest.bzl", "KMP_MODULE_BUSINESS_TESTS", "KMP_MODULE_JVM_TESTS")

# ── Android KMP resources ─────────────────────────────────────────────────────
# res/ lives in the kmp/ Bazel package (no BUILD in src/androidMain/), so the
# android_library that exposes R must be defined here.
android_library(
    name = "kmp_android_resources",
    custom_package = "dev.stapler.stelekit",
    manifest = "src/androidMain/AndroidManifest.xml",
    resource_files = glob(["src/androidMain/res/**"]),
    visibility = ["//kmp/src/androidMain/kotlin:__pkg__"],
)

# ── JVM / Desktop ─────────────────────────────────────────────────────────────

alias(
    name = "desktop_app",
    actual = "//kmp/src/jvmMain/kotlin:desktop_app",
    visibility = ["//visibility:public"],
)

alias(
    name = "sketch_cli",
    actual = "//kmp/src/jvmMain/kotlin:sketch_cli",
    visibility = ["//visibility:public"],
)

# ── Android ───────────────────────────────────────────────────────────────────

alias(
    name = "android_app",
    actual = "//androidApp:android_app",
    visibility = ["//visibility:public"],
)

# ── Tests ─────────────────────────────────────────────────────────────────────

test_suite(
    name = "jvm_tests",
    # Plus the jvmTest classes moved to per-module targets (scripts/kmp-module-tests-sync.py).
    tests = [
        "//kmp/src/jvmTest/kotlin:jvm_tests",
        "//kmp/src/jvmTest/kotlin:mermaid_jvm_tests",
    ] + ["//kmp/modules:%s_jvm_tests" % m for m in sorted(KMP_MODULE_JVM_TESTS)],
    visibility = ["//visibility:public"],
)

test_suite(
    name = "business_tests",
    # Plus the businessTest classes moved to per-module targets (scripts/kmp-module-tests-sync.py).
    tests = ["//kmp/src/businessTest/kotlin:business_tests"] + [
        "//kmp/modules:%s_business_tests" % m
        for m in sorted(KMP_MODULE_BUSINESS_TESTS)
    ],
    visibility = ["//visibility:public"],
)

# The module-split manifest, bundled as a classpath resource for ModuleManifestGuardTest (businessTest).
exports_files(
    ["modules_manifest.bzl"],
    visibility = ["//kmp:__subpackages__"],
)

# Exposes the SQLDelight schema source so MigrationRunnerSchemaSyncTest can bundle it as a
# classpath resource (Bazel path — see kmp/src/businessTest/kotlin/BUILD.bazel) instead of
# relying on the Gradle-only -Dstelekit.sq.file system property.
filegroup(
    name = "sqldelight_schema_source",
    srcs = ["src/commonMain/sqldelight/dev/stapler/stelekit/db/SteleDatabase.sq"],
    visibility = ["//kmp:__subpackages__"],
)

# ── Web / WASM-JS ─────────────────────────────────────────────────────────────
#
# Kotlin/WASM is not yet supported by rules_kotlin (tracking: rules_kotlin#567).
# This genrule wraps the Gradle wasmJsBrowserDistribution task so the web bundle
# is addressable as a Bazel target today.  When rules_kotlin ships native WASM
# support the genrule can be replaced with kt_wasm_library + bundler rules.
#
# The target runs without sandboxing (tags = ["local"]) because Gradle manages
# its own dependency resolution and the hermetic Bazel sandbox would block it.
# Gradle's own incremental cache provides action-level caching in the interim.
#
# Build: bazel build //kmp:web_app
# Output: bazel-bin/kmp/web_dist.tar.gz  (unpack to serve the browser bundle)
# Everything Gradle reads for the bundle. Without these Bazel never re-ran the action after an edit.
# scripts/ci/check-web-srcs.sh fails if a file under commonMain or wasmJsMain is missing.
filegroup(
    name = "web_srcs",
    srcs = [
        "build.gradle.kts",
        "gradle.properties",
    ] + glob([
        "src/commonMain/composeResources/**",
        "src/commonMain/sqldelight/**",
        "src/commonMain/sqldelightTelemetry/**",
    ]),
)

genrule(
    name = "web_dist",
    srcs = [
        ":web_srcs",
        "//:web_build_files",
        "//buildSrc:web_build_files",
        "//kmp/src/commonMain/kotlin:web_srcs",
        "//kmp/src/commonMain/kotlin/dev/stapler/stelekit/stats:web_srcs",
        "//kmp/src/commonMain/resources:web_srcs",
        "//kmp/src/wasmJsMain/kotlin:web_srcs",
        "//kmp/src/wasmJsMain/resources:web_srcs",
    ],
    outs = ["web_dist.tar.gz"],
    cmd = """
        WORKSPACE=$$(dirname $$(realpath gradlew)) && \
        "$$WORKSPACE/gradlew" :kmp:wasmJsBrowserDistribution \
          --project-dir "$$WORKSPACE" \
          -PenableJs=true --no-daemon --quiet && \
        tar -czf $(OUTS) -C "$$WORKSPACE/kmp/build/dist/wasmJs/productionExecutable" .
    """,
    tags = ["local"],
    visibility = ["//visibility:public"],
)

alias(
    name = "web_app",
    actual = ":web_dist",
    visibility = ["//visibility:public"],
)

# ── Detekt linting (ADR-008) ──────────────────────────────────────────────────
# Run: bazel test //kmp:detekt. Mirrors the `detekt { }` block in build.gradle.kts; keep them in step.
# "output was not created" means detekt itself crashed (e.g. bad config); run the Gradle task to see why.
detekt_test(
    name = "detekt",
    srcs = [
        "//kmp/src/androidMain/kotlin:detekt_srcs",
        "//kmp/src/commonMain/kotlin:detekt_srcs",
        "//kmp/src/commonMain/kotlin/dev/stapler/stelekit/stats:detekt_srcs",
        "//kmp/src/iosMain/kotlin:detekt_srcs",
        "//kmp/src/jvmCommonMain/kotlin:detekt_srcs",
        "//kmp/src/jvmMain/kotlin:detekt_srcs",
    ],
    baseline = "config/detekt/baseline.xml",
    build_upon_default_config = True,
    cfgs = ["config/detekt/detekt.yml"],
    html_report = True,
    parallel = True,
    size = "small",
    # Detekt does not resolve plugin dependencies, so every jar is listed.
    plugins = [
        "//buildSrc:detekt_rules_jar",
        "@detekt_maven//:io_nlopez_compose_rules_common_detekt",
        "@detekt_maven//:io_nlopez_compose_rules_detekt",
        # The Compose rules need a newer stdlib than the one bundled in the detekt CLI.
        "@detekt_maven//:org_jetbrains_kotlin_kotlin_stdlib",
    ],
)
